# Variables d'environnement attendues. Copier en .env (ignoré par Git) et remplir en local.
# Ne jamais commiter de valeur réelle.

# Active les routes de l'outil de démo (bouton « Simuler la réponse de la ferme »). Vide en production.
DEMO_MODE=

# Mot de passe des comptes créés par db/seeds.rb. À définir sur Scalingo (le dépôt est public).
SEED_PASSWORD=

# Production seulement (Scalingo, décision 0003). Ne pas mettre dans .env en local.
# RAILS_MASTER_KEY : le contenu de config/master.key, pour lire config/credentials.yml.enc.
# SOLID_QUEUE_IN_PUMA=1 : les tâches de fond tournent dans le conteneur web (config/puma.rb).
# DATABASE_URL : posée par l'addon PostgreSQL de Scalingo, jamais à la main.

# E-mail par Brevo, en SMTP (story 8, en production seulement).
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
