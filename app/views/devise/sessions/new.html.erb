<%# Connexion (story 14). Vue générée par Devise puis mise sur la charte : les textes
    viennent de devise-i18n (t(".sign_in") lit devise.sessions.new.sign_in), le
    formulaire de Simple Form, dans une carte centrée. %>
<% content_for :title, "#{t('.sign_in')} · #{t('app_name')}" %>

<div class="container">
  <div class="col-md-8 col-lg-5 col-xl-4 mx-auto">
    <%= render "devise/shared/auth_header", title: t(".sign_in") %>

    <div class="card">
      <div class="card-body p-4">
        <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <%= f.input :email,
                      required: false,
                      autofocus: true,
                      input_html: { autocomplete: "email" } %>
          <%= f.input :password,
                      required: false,
                      input_html: { autocomplete: "current-password" } %>
          <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>

          <%= f.button :submit, t(".sign_in"), class: "btn btn-primary btn-lg w-100 mt-2" %>
        <% end %>
      </div>
    </div>

    <%= render "devise/shared/links" %>
  </div>
</div>
