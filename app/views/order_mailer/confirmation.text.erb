<%= t("app_name") %>

<%= t(".intro", reference: @order.reference) %>

<%= t(".date") %> : <%= l(@order.accepted_at || @order.created_at, format: "%d/%m/%Y %H:%M") %>
<%= t(".buyer") %> : <%= @order.buyer_company.name %>
<%= t(".seller") %> : <%= @order.seller_company.name %>
<%= t(".product") %> : <%= @order.product.name %>
<%= t(".quantity") %> : <%= t(".quantity_value", quantity: @order.quantity, unit: @order.unit) %>
<%= t(".unit_price") %> : <%= format_price(@order.unit_price_cents) %>
<%= t(".total") %> : <%= format_price(@order.total_cents) %>

<%= t(".attachment") %>
