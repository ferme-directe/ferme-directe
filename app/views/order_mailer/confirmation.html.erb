<%# Corps HTML du bon de commande (story 8). Mêmes données qu'avant ; seule la mise en forme change.
    terre #6E5443 pour les libellés, trait #E4DDD0 pour les filets, blé pâle #F5EACB pour le total. %>
<% label_style = "padding:10px 16px 10px 0; border-bottom:1px solid #E4DDD0; text-align:left; font-weight:normal; color:#6E5443; font-size:13px; white-space:nowrap;" %>
<% value_style = "padding:10px 0; border-bottom:1px solid #E4DDD0; text-align:left;" %>

<p style="margin:0 0 4px; font-size:22px; font-weight:bold; color:#2E463A;"><%= t(".subject", reference: @order.reference) %></p>
<p style="margin:0 0 20px; color:#6E5443;"><%= t(".intro", reference: @order.reference) %></p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
  <tr>
    <th style="<%= label_style %>"><%= t(".date") %></th>
    <td style="<%= value_style %>"><%= l(@order.accepted_at || @order.created_at, format: "%d/%m/%Y %H:%M") %></td>
  </tr>
  <tr>
    <th style="<%= label_style %>"><%= t(".buyer") %></th>
    <td style="<%= value_style %>"><%= @order.buyer_company.name %></td>
  </tr>
  <tr>
    <th style="<%= label_style %>"><%= t(".seller") %></th>
    <td style="<%= value_style %>"><%= @order.seller_company.name %></td>
  </tr>
  <tr>
    <th style="<%= label_style %>"><%= t(".product") %></th>
    <td style="<%= value_style %>"><%= @order.product.name %></td>
  </tr>
  <tr>
    <th style="<%= label_style %>"><%= t(".quantity") %></th>
    <td style="<%= value_style %>"><%= t(".quantity_value", quantity: @order.quantity, unit: unit_label(@order.unit, @order.quantity)) %></td>
  </tr>
  <tr>
    <th style="<%= label_style %>"><%= t(".unit_price") %></th>
    <td style="<%= value_style %>"><%= format_price(@order.unit_price_cents) %></td>
  </tr>
  <tr>
    <th style="padding:12px 16px 12px 12px; background-color:#F5EACB; text-align:left; font-weight:bold; color:#2E463A;"><%= t(".total") %></th>
    <td style="padding:12px 12px 12px 0; background-color:#F5EACB; text-align:left; font-weight:bold; font-size:18px; color:#2E463A;"><%= format_price(@order.total_cents) %></td>
  </tr>
</table>

<p style="margin:20px 0 0; padding:12px 14px; border:1px dashed #E4DDD0; border-radius:8px; color:#6E5443; font-size:14px;">📎 <%= t(".attachment") %></p>
