<% content_for :title, t(".title", reference: @order.reference) %>

<main class="container py-4">
  <h1 class="h3"><%= t(".title", reference: @order.reference) %></h1>
  <p><%= link_to t(".download"), order_path(@order, format: :pdf) %></p>

  <dl class="row">
    <dt class="col-sm-4"><%= t(".reference") %></dt>
    <dd class="col-sm-8"><%= @order.reference %></dd>

    <dt class="col-sm-4"><%= t(".timestamp") %></dt>
    <dd class="col-sm-8"><%= l(@order.accepted_at || @order.created_at, format: "%d/%m/%Y %H:%M") %></dd>

    <dt class="col-sm-4"><%= t(".buyer") %></dt>
    <dd class="col-sm-8"><%= @order.buyer_company.name %></dd>

    <dt class="col-sm-4"><%= t(".seller") %></dt>
    <dd class="col-sm-8"><%= @order.seller_company.name %></dd>

    <dt class="col-sm-4"><%= t(".product") %></dt>
    <dd class="col-sm-8"><%= @order.product.name %></dd>

    <dt class="col-sm-4"><%= t(".label") %></dt>
    <dd class="col-sm-8"><%= @order.label %></dd>

    <dt class="col-sm-4"><%= t(".quantity") %></dt>
    <dd class="col-sm-8"><%= t(".quantity_value", quantity: @order.quantity, unit: @order.unit) %></dd>

    <dt class="col-sm-4"><%= t(".unit_price") %></dt>
    <dd class="col-sm-8"><%= number_to_currency(BigDecimal(@order.unit_price_cents) / 100) %></dd>

    <dt class="col-sm-4"><%= t(".total") %></dt>
    <dd class="col-sm-8"><%= number_to_currency(BigDecimal(@order.total_cents) / 100) %></dd>

    <dt class="col-sm-4"><%= t(".fulfillment") %></dt>
    <dd class="col-sm-8"><%= @order.human_enum(:fulfillment) %></dd>

    <dt class="col-sm-4"><%= t(".status") %></dt>
    <dd class="col-sm-8"><%= @order.human_enum(:status) %></dd>

    <dt class="col-sm-4"><%= t(".address") %></dt>
    <dd class="col-sm-8">
      <%= @order.address.street %><br>
      <%= @order.address.postcode %> <%= @order.address.city %>
    </dd>
  </dl>
</main>
